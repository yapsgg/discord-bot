[Unit]
Description=YapsGG Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
